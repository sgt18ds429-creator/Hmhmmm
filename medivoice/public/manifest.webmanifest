{
  "name": "ميدي فويز",
  "short_name": "ميدي فويز",
  "description": "حوّل تسجيل المحاضرة إلى ملزمة PDF مشروحة بالتفصيل، بالمصطلحات الطبية وصور مطابقة للشرح",
  "lang": "ar",
  "dir": "rtl",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{
        "name": "audio",
        "accept": ["audio/*", "video/*", ".m4a", ".mp3", ".wav", ".ogg", ".oga", ".opus", ".aac", ".flac", ".amr", ".3gp", ".mp4", ".webm", ".mkv", ".mov"]
      }]
    }
  },
  "display": "standalone",
  "background_color": "#0C0618",
  "theme_color": "#0C0618",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
